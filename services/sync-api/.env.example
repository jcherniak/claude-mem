# Required. Neon (or local) Postgres connection string.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/sync_api_test

# Same names as services/sync-hub.
TOKEN_VERIFY_URL=https://cmem.ai/api/pro/sync/verify
AUTH_CACHE_TTL_SECONDS=900
INTERNAL_PROJECTOR_URL=https://cmem.ai/api/internal/sync/project
CMEM_INTERNAL_PROJECTOR_SECRET=

# Listen. Fly sets PORT; default matches fly.toml internal_port.
PORT=8080
HOST=0.0.0.0

SYNC_AUTH_MODE=cmem
SYNC_PROJECTION_MODE=external
SYNC_DB_POOL_SIZE=10
SYNC_USER_ID=personal
SYNC_PUBLIC_URL=
